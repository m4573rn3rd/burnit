##############################################
#  FileName: .gitignore
#  FileDescription: Excludes secrets and temporary files from Git
##############################################

# --- Security (CRITICAL) ---
.env
.env.*
secrets.json
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
pip-log.txt
passwd # Just in case

# --- OS Generated ---
.DS_Store
Thumbs.db

# --- IDEs ---
.vscode/
.idea/